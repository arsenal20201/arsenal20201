//@version=5
// =====================================================================
//  HIGH WIN-RATE PRO  —  TradingView strategy
//  Trend (EMA50/EMA200) + RSI pullback entries, ATR risk, R-multiple
//  target, optional break-even. Clear on-chart Buy/Sell labels with
//  Entry / SL / TP, live stop & target lines, dashboard, and alerts.
//  Written with single-line statements (no fragile multi-line / helper
//  functions) for maximum compile reliability.
//
//  Educational tool, not financial advice. Backtest with realistic
//  commission + slippage and forward-test before risking real money.
// =====================================================================
strategy("High Win-Rate Pro", overlay=true, initial_capital=1000, default_qty_type=strategy.percent_of_equity, default_qty_value=5, commission_type=strategy.commission.percent, commission_value=0.02, slippage=2, pyramiding=0, process_orders_on_close=true, max_labels_count=200, max_lines_count=200)

// ---------------------------- Inputs ----------------------------
emaFastLen = input.int(50,  "Fast EMA",                 group="Trend")
emaSlowLen = input.int(200, "Slow EMA",                 group="Trend")
rsiLen     = input.int(14,  "RSI length",               group="Entry")
rsiLongLvl = input.float(40,"RSI pullback level (long)", group="Entry")
rsiShortLvl= input.float(60,"RSI pullback level (short)",group="Entry")
atrLen     = input.int(14,  "ATR length",               group="Risk")
slMult     = input.float(1.5,"Stop = ATR x",            group="Risk", minval=0.1)
rr         = input.float(1.8,"Reward : Risk",           group="Risk", minval=0.1)
riskPct    = input.float(1.0,"Risk % per trade",        group="Risk", minval=0.1, maxval=10)
useBE      = input.bool(true,"Move stop to break-even at 1R", group="Manage")
allowLong  = input.bool(true, "Allow longs",            group="General")
allowShort = input.bool(true, "Allow shorts",           group="General")
showDash   = input.bool(true, "Show dashboard",         group="Display")
showLines  = input.bool(true, "Show entry/SL/TP lines", group="Display")

// ---------------------------- Indicators ------------------------
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
rsi     = ta.rsi(close, rsiLen)
atr     = ta.atr(atrLen)

up = emaFast > emaSlow and close > emaSlow
dn = emaFast < emaSlow and close < emaSlow

longSig  = allowLong  and up and ta.crossover(rsi, rsiLongLvl)
shortSig = allowShort and dn and ta.crossunder(rsi, rsiShortLvl)

// ---------------------------- State -----------------------------
var float eEntry = na
var float eSL    = na
var float eTP    = na
var float eR     = na
var bool  beDone = false
flat = strategy.position_size == 0

// ---------------------------- Entries ---------------------------
if longSig and flat
    eEntry := close
    eSL    := close - atr * slMult
    eR     := eEntry - eSL
    eTP    := eEntry + eR * rr
    beDone := false
    q = eR > 0 and syminfo.pointvalue > 0 ? (strategy.equity * riskPct / 100.0) / (eR * syminfo.pointvalue) : na
    strategy.entry("Long", strategy.long, qty=q)
    label.new(bar_index, low, "BUY " + str.tostring(eEntry, format.mintick) + "\nSL " + str.tostring(eSL, format.mintick) + "\nTP " + str.tostring(eTP, format.mintick), yloc=yloc.belowbar, style=label.style_label_up, color=color.new(color.green, 0), textcolor=color.white, size=size.small)

if shortSig and flat
    eEntry := close
    eSL    := close + atr * slMult
    eR     := eSL - eEntry
    eTP    := eEntry - eR * rr
    beDone := false
    q = eR > 0 and syminfo.pointvalue > 0 ? (strategy.equity * riskPct / 100.0) / (eR * syminfo.pointvalue) : na
    strategy.entry("Short", strategy.short, qty=q)
    label.new(bar_index, high, "SELL " + str.tostring(eEntry, format.mintick) + "\nSL " + str.tostring(eSL, format.mintick) + "\nTP " + str.tostring(eTP, format.mintick), yloc=yloc.abovebar, style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white, size=size.small)

// ---------------------------- Manage ----------------------------
if strategy.position_size > 0
    if useBE and not beDone and high >= eEntry + eR
        eSL := eEntry
        beDone := true
    strategy.exit("Long X", "Long", stop=eSL, limit=eTP)

if strategy.position_size < 0
    if useBE and not beDone and low <= eEntry - eR
        eSL := eEntry
        beDone := true
    strategy.exit("Short X", "Short", stop=eSL, limit=eTP)

// clear levels when flat so the dashboard never shows stale data
var float prevSize = 0.0
if prevSize != 0 and strategy.position_size == 0
    eEntry := na
    eSL    := na
    eTP    := na
prevSize := strategy.position_size

// ---------------------------- Visuals ---------------------------
p1 = plot(emaFast, "EMA Fast", color=color.new(color.orange, 0), linewidth=1)
p2 = plot(emaSlow, "EMA Slow", color=color.new(color.blue, 0),   linewidth=2)
fill(p1, p2, color = up ? color.new(color.green, 88) : dn ? color.new(color.red, 88) : na)

inPos = strategy.position_size != 0
plot(showLines and inPos ? eEntry : na, "Entry",  color=color.new(color.gray, 0),  style=plot.style_linebr, linewidth=1)
plot(showLines and inPos ? eSL    : na, "Stop",   color=color.new(color.red, 0),   style=plot.style_linebr, linewidth=2)
plot(showLines and inPos ? eTP    : na, "Target", color=color.new(color.green, 0), style=plot.style_linebr, linewidth=2)

plotshape(longSig  and flat, "Buy",  shape.triangleup,   location.belowbar, color.new(color.green, 0), size=size.small)
plotshape(shortSig and flat, "Sell", shape.triangledown, location.abovebar, color.new(color.red, 0),   size=size.small)
bgcolor(up ? color.new(color.green, 95) : dn ? color.new(color.red, 95) : na, title="Trend tint")

// ---------------------------- Alerts ----------------------------
alertcondition(longSig  and flat, "Long entry",  "HWR Pro: LONG setup")
alertcondition(shortSig and flat, "Short entry", "HWR Pro: SHORT setup")

// ---------------------------- Dashboard -------------------------
var table dash = table.new(position.top_right, 2, 13, frame_width=1, frame_color=color.new(color.gray, 0), border_width=1, border_color=color.new(color.gray, 50))
cBg  = color.new(#1e222d, 0)
cHd  = color.new(#2a2e39, 0)
if barstate.islast and showDash
    trendTxt = up ? "UP" : dn ? "DOWN" : "RANGE"
    posTxt   = strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT"
    riskUsd  = inPos ? math.abs(eEntry - eSL) * math.abs(strategy.position_size) * syminfo.pointvalue : na
    pf       = strategy.grossloss != 0 ? strategy.grossprofit / strategy.grossloss : na
    winPct   = strategy.closedtrades > 0 ? strategy.wintrades / strategy.closedtrades * 100 : na
    netPct   = strategy.netprofit / strategy.initial_capital * 100
    ddPct    = strategy.max_drawdown / strategy.initial_capital * 100
    posBg    = strategy.position_size > 0 ? color.new(color.green, 0) : strategy.position_size < 0 ? color.new(color.red, 0) : cBg
    table.cell(dash, 0, 0, "HIGH WIN-RATE PRO", text_color=color.white, bgcolor=cHd, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 0, posTxt,             text_color=color.white, bgcolor=posBg, text_size=size.small, text_halign=text.align_right)
    table.cell(dash, 0, 1, "Trend",      text_color=color.white, bgcolor=cBg, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 1, trendTxt,     text_color=color.white, bgcolor=cBg, text_size=size.small, text_halign=text.align_right)
    table.cell(dash, 0, 2, "RSI",        text_color=color.white, bgcolor=cBg, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 2, str.tostring(rsi, "#.#"), text_color=color.white, bgcolor=cBg, text_size=size.small, text_halign=text.align_right)
    table.cell(dash, 0, 3, "Entry",      text_color=color.white, bgcolor=cBg, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 3, inPos ? str.tostring(eEntry, format.mintick) : "-", text_color=color.white, bgcolor=cBg, text_size=size.small, text_halign=text.align_right)
    table.cell(dash, 0, 4, "Stop loss",  text_color=color.white, bgcolor=cBg, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 4, inPos ? str.tostring(eSL, format.mintick) : "-",    text_color=color.white, bgcolor=cBg, text_size=size.small, text_halign=text.align_right)
    table.cell(dash, 0, 5, "Target",     text_color=color.white, bgcolor=cBg, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 5, inPos ? str.tostring(eTP, format.mintick) : "-",    text_color=color.white, bgcolor=cBg, text_size=size.small, text_halign=text.align_right)
    table.cell(dash, 0, 6, "Risk ($)",   text_color=color.white, bgcolor=cBg, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 6, inPos ? str.tostring(riskUsd, "#.##") : "-",        text_color=color.white, bgcolor=cBg, text_size=size.small, text_halign=text.align_right)
    table.cell(dash, 0, 7, "PERFORMANCE",text_color=color.white, bgcolor=cHd, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 7, "",           text_color=color.white, bgcolor=cHd, text_size=size.small, text_halign=text.align_right)
    table.cell(dash, 0, 8, "Net %",      text_color=color.white, bgcolor=cBg, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 8, str.tostring(netPct, "#.##"), text_color=color.white, bgcolor=cBg, text_size=size.small, text_halign=text.align_right)
    table.cell(dash, 0, 9, "Win %",      text_color=color.white, bgcolor=cBg, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 9, str.tostring(winPct, "#.#"),  text_color=color.white, bgcolor=cBg, text_size=size.small, text_halign=text.align_right)
    table.cell(dash, 0, 10,"Profit factor",text_color=color.white, bgcolor=cBg, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 10,str.tostring(pf, "#.##"),     text_color=color.white, bgcolor=cBg, text_size=size.small, text_halign=text.align_right)
    table.cell(dash, 0, 11,"Trades",     text_color=color.white, bgcolor=cBg, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 11,str.tostring(strategy.closedtrades), text_color=color.white, bgcolor=cBg, text_size=size.small, text_halign=text.align_right)
    table.cell(dash, 0, 12,"Max DD %",   text_color=color.white, bgcolor=cBg, text_size=size.small, text_halign=text.align_left)
    table.cell(dash, 1, 12,str.tostring(ddPct, "#.##"),  text_color=color.white, bgcolor=cBg, text_size=size.small, text_halign=text.align_right)
// =====================================================================
