//@version=5
// =====================================================================
//  High Win-Rate Mean-Reversion  v3  —  TradingView strategy
//  ---------------------------------------------------------------------
//  Lesson from v1/v2: over-filtering enters late and misses the move.
//  v3 goes back to a clean, proven HIGH-WIN-RATE style — RSI mean
//  reversion in the direction of the trend ("buy the dip in an uptrend,
//  sell the rip in a downtrend") — with strict risk management and an
//  on-chart DASHBOARD that draws entry / stop / targets for every trade.
//
//  Core idea (long; short is the mirror):
//    * Trend up:    price above the trend EMA (default EMA200)
//    * Oversold dip: short-period RSI drops below the oversold level
//    * Enter the bounce, stop beyond structure/ATR, target a multiple
//      of risk, scale out + trail the rest.
//
//  Optional filters (HTF agreement, ADX strength, confirm candle) are
//  OFF by default — turn them on only if YOUR backtest says they help.
//
//  Educational tool, not financial advice. Backtest with realistic
//  commission + slippage, then forward-test before risking real money.
// =====================================================================
strategy("High Win-Rate Mean-Reversion v3",
     overlay              = true,
     pyramiding           = 0,
     initial_capital      = 1000,
     default_qty_type     = strategy.fixed,
     commission_type      = strategy.commission.percent,
     commission_value     = 0.0,
     slippage             = 0,
     calc_on_every_tick   = false,
     process_orders_on_close = true,
     max_labels_count     = 100,
     max_lines_count      = 100)

// ---------------------------------------------------------------------
// Inputs — Strategy core
// ---------------------------------------------------------------------
gStrat       = "Strategy"
rsiLen       = input.int(3,    "RSI period (short = mean reversion)", group=gStrat, minval=1)
rsiOS        = input.float(15, "Oversold level (long entries)",      group=gStrat)
rsiOB        = input.float(85, "Overbought level (short entries)",   group=gStrat)
useTrend     = input.bool(true,"Trade only with the trend EMA",      group=gStrat)
trendEmaLen  = input.int(200,  "Trend EMA period",                   group=gStrat, minval=5)
atrLen       = input.int(14,   "ATR period",                         group=gStrat, minval=2)
allowLongs   = input.bool(true,"Allow longs",                        group=gStrat)
allowShorts  = input.bool(true,"Allow shorts",                       group=gStrat)

// ---------------------------------------------------------------------
// Inputs — Optional filters (default OFF; enable only if they help YOU)
// ---------------------------------------------------------------------
gOpt         = "Optional Filters"
useHtf       = input.bool(false,  "Require higher-TF trend agreement", group=gOpt)
htfTf        = input.timeframe("240","Higher timeframe",               group=gOpt)
htfEmaLen    = input.int(200,     "Higher-TF EMA period",              group=gOpt, minval=5)
useAdx       = input.bool(false,  "Require ADX trend strength",        group=gOpt)
adxLen       = input.int(14,      "ADX / DMI length",                  group=gOpt, minval=2)
adxMin       = input.float(18,    "Min ADX to trade",                  group=gOpt)
useConfirm   = input.bool(false,  "Require confirmation candle",       group=gOpt)

// ---------------------------------------------------------------------
// Inputs — Stops & targets
// ---------------------------------------------------------------------
gStops       = "Stops & Targets"
useSwingStop = input.bool(true, "Structure (swing) stop",            group=gStops)
swingLook    = input.int(10,    "Swing lookback (bars)",             group=gStops, minval=2)
stopBufAtr   = input.float(0.3, "Stop buffer beyond swing (ATR x)",  group=gStops, minval=0)
atrSlMult    = input.float(1.5, "Min stop = ATR x",                  group=gStops, minval=0.1)
maxStopAtr   = input.float(3.5, "Max stop = ATR x",                  group=gStops, minval=0.5)
rrRatio      = input.float(1.5, "Take-profit R:R",                   group=gStops, minval=0.1)
minAtrPoints = input.int(0,     "Min ATR in ticks (0=off)",          group=gStops, minval=0)

// ---------------------------------------------------------------------
// Inputs — Risk management
// ---------------------------------------------------------------------
gRisk        = "Risk Management"
riskPercent  = input.float(1.0, "Risk % of equity per trade",     group=gRisk, minval=0.1, maxval=20)
maxDailyLoss = input.float(4.0, "Max daily loss % (stop)",        group=gRisk, minval=0)
dailyProfit  = input.float(6.0, "Daily profit lock % (0=off)",    group=gRisk, minval=0)
maxTradesDay = input.int(5,     "Max trades per day (0=off)",     group=gRisk, minval=0)
maxConsLoss  = input.int(3,     "Cooldown after N losses (0=off)",group=gRisk, minval=0)

// ---------------------------------------------------------------------
// Inputs — Session filter
// ---------------------------------------------------------------------
gSess        = "Session Filter"
useSession   = input.bool(false,       "Restrict trading hours", group=gSess)
sessionTime  = input.session("0700-2000","Session (exchange tz)",group=gSess)

// ---------------------------------------------------------------------
// Inputs — Trade management
// ---------------------------------------------------------------------
gManage      = "Trade Management"
usePartial   = input.bool(true,  "Scale out partial at first target", group=gManage)
partialTrigR = input.float(1.0,  "Take partial after this many R",    group=gManage, minval=0.1)
partialPct   = input.float(50,   "% of position to close at partial", group=gManage, minval=1, maxval=99)
useBE        = input.bool(true,  "Enable break-even",                 group=gManage)
beTriggerR   = input.float(1.0,  "Move to BE after this many R",      group=gManage, minval=0.1)
beLockTicks  = input.int(20,     "Ticks locked beyond entry at BE",   group=gManage, minval=0)
useTrail     = input.bool(true,  "Enable ATR trailing stop",          group=gManage)
trailAtrMult = input.float(2.0,  "Trailing distance = ATR x",         group=gManage, minval=0.1)
trailStartR  = input.float(1.5,  "Start trailing after this many R",  group=gManage, minval=0.1)

// ---------------------------------------------------------------------
// Inputs — Dashboard
// ---------------------------------------------------------------------
gDash        = "Dashboard"
showLevels   = input.bool(true, "Draw entry / stop / target lines", group=gDash)
showStats    = input.bool(true, "Show info table",                  group=gDash)

// ---------------------------------------------------------------------
// Indicators
// ---------------------------------------------------------------------
rsi      = ta.rsi(close, rsiLen)
trendEma = ta.ema(close, trendEmaLen)
atr      = ta.atr(atrLen)
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)

// BUGFIX #2: take the last CONFIRMED higher-TF value ([1]) so the filter does
// not repaint on the still-forming HTF bar.
htfEma   = request.security(syminfo.tickerid, htfTf, ta.ema(close, htfEmaLen)[1], lookahead=barmerge.lookahead_off)
htfClose = request.security(syminfo.tickerid, htfTf, close[1],                    lookahead=barmerge.lookahead_off)
htfBull = not useHtf or htfClose > htfEma
htfBear = not useHtf or htfClose < htfEma

adxStrong = not useAdx or adxVal >= adxMin
dirOkL    = not useAdx or diPlus > diMinus
dirOkS    = not useAdx or diMinus > diPlus

// ---------------------------------------------------------------------
// Daily guardrails + consecutive-loss cooldown
// ---------------------------------------------------------------------
var float dayStartEquity = na
var int   tradesToday    = 0
var int   consLosses     = 0
if na(dayStartEquity)
    dayStartEquity := strategy.equity
newDay = ta.change(time("D")) != 0
if newDay
    dayStartEquity := strategy.equity
    tradesToday    := 0
    consLosses     := 0
// NOTE: the loss-streak counter is updated on a true FULL close (see below),
// not on every closedtrades change, so scale-out partials don't corrupt it.

dailyPnLPct  = dayStartEquity > 0 ? (strategy.equity - dayStartEquity) / dayStartEquity * 100 : 0.0
lossLimitHit = maxDailyLoss > 0 and dailyPnLPct <= -maxDailyLoss
profitLocked = dailyProfit   > 0 and dailyPnLPct >=  dailyProfit
maxTradesHit = maxTradesDay  > 0 and tradesToday >=  maxTradesDay
coolingDown  = maxConsLoss   > 0 and consLosses  >=  maxConsLoss
inSession    = not useSession or not na(time(timeframe.period, sessionTime))
atrOk        = minAtrPoints <= 0 or (atr / syminfo.mintick) >= minAtrPoints
canTrade     = not lossLimitHit and not profitLocked and not maxTradesHit and not coolingDown and inSession and atrOk

// ---------------------------------------------------------------------
// Entry logic — RSI mean reversion with the trend
// ---------------------------------------------------------------------
trendUp   = not useTrend or close > trendEma
trendDn   = not useTrend or close < trendEma
confirmL  = not useConfirm or close > open
confirmS  = not useConfirm or close < open

longSignal  = allowLongs  and trendUp and htfBull and adxStrong and dirOkL and ta.crossunder(rsi, rsiOS) and confirmL
shortSignal = allowShorts and trendDn and htfBear and adxStrong and dirOkS and ta.crossover(rsi, rsiOB)  and confirmS

// ---------------------------------------------------------------------
// Structure-based stop helpers
// ---------------------------------------------------------------------
// BUGFIX #4: clamp between the nearest and farthest allowed stop regardless of
// whether maxStopAtr was set >= atrSlMult (order-independent bounds).
calcLongStop() =>
    swing   = ta.lowest(low, swingLook) - stopBufAtr * atr
    nearest = close - atrSlMult * atr        // closest allowed (highest price)
    farthest= close - maxStopAtr * atr        // farthest allowed (lowest price)
    hi      = math.max(nearest, farthest)
    lo      = math.min(nearest, farthest)
    raw     = useSwingStop ? math.min(swing, hi) : hi
    math.max(math.min(raw, hi), lo)

calcShortStop() =>
    swing   = ta.highest(high, swingLook) + stopBufAtr * atr
    nearest = close + atrSlMult * atr
    farthest= close + maxStopAtr * atr
    hi      = math.max(nearest, farthest)
    lo      = math.min(nearest, farthest)
    raw     = useSwingStop ? math.max(swing, lo) : lo
    math.min(math.max(raw, lo), hi)

// ---------------------------------------------------------------------
// Position state
// ---------------------------------------------------------------------
var float entryPrice   = na
var float rDist        = na
var float finalTP      = na
var float curStop      = na
var bool  partialTaken = false   // BUGFIX #5: take the scale-out only once per trade
flat = strategy.position_size == 0

if longSignal and canTrade and flat
    stopPrice  = calcLongStop()
    entryPrice := close
    rDist      := close - stopPrice
    finalTP    := close + rDist * rrRatio
    curStop    := stopPrice
    partialTaken := false
    qty        = (strategy.equity * riskPercent / 100.0) / (rDist * syminfo.pointvalue)
    strategy.entry("Long", strategy.long, qty=qty)
    tradesToday += 1

if shortSignal and canTrade and flat
    stopPrice  = calcShortStop()
    entryPrice := close
    rDist      := stopPrice - close
    finalTP    := close - rDist * rrRatio
    curStop    := stopPrice
    partialTaken := false
    qty        = (strategy.equity * riskPercent / 100.0) / (rDist * syminfo.pointvalue)
    strategy.entry("Short", strategy.short, qty=qty)
    tradesToday += 1

// ---------------------------------------------------------------------
// Trade management: break-even -> ATR trailing, with scale-out partial
// ---------------------------------------------------------------------
if strategy.position_size > 0 and rDist > 0
    if useBE and high >= entryPrice + beTriggerR * rDist
        curStop := math.max(curStop, entryPrice + beLockTicks * syminfo.mintick)
    if useTrail and high >= entryPrice + trailStartR * rDist
        curStop := math.max(curStop, close - trailAtrMult * atr)
    if usePartial and not partialTaken
        strategy.exit("L-TP1", from_entry="Long", qty_percent=partialPct,
                     limit=entryPrice + partialTrigR * rDist, stop=curStop)
        if high >= entryPrice + partialTrigR * rDist
            partialTaken := true   // filled -> stop re-issuing the scale-out
    strategy.exit("L-Exit", from_entry="Long", stop=curStop, limit=finalTP)

if strategy.position_size < 0 and rDist > 0
    if useBE and low <= entryPrice - beTriggerR * rDist
        curStop := math.min(curStop, entryPrice - beLockTicks * syminfo.mintick)
    if useTrail and low <= entryPrice - trailStartR * rDist
        curStop := math.min(curStop, close + trailAtrMult * atr)
    if usePartial and not partialTaken
        strategy.exit("S-TP1", from_entry="Short", qty_percent=partialPct,
                     limit=entryPrice - partialTrigR * rDist, stop=curStop)
        if low <= entryPrice - partialTrigR * rDist
            partialTaken := true
    strategy.exit("S-Exit", from_entry="Short", stop=curStop, limit=finalTP)

// BUGFIX #3/#6: update the loss-streak ONLY on a true full close, and clear the
// per-trade state so the dashboard / levels never show stale values.
var float prevPosSize = 0.0
if prevPosSize != 0 and strategy.position_size == 0
    consLosses := strategy.closedtrades.profit(strategy.closedtrades - 1) < 0 ? consLosses + 1 : 0
    entryPrice := na
    rDist      := na
    finalTP    := na
    curStop    := na
    partialTaken := false
prevPosSize := strategy.position_size

// ---------------------------------------------------------------------
// DASHBOARD — draw entry / stop / target on the chart
// ---------------------------------------------------------------------
longPos  = strategy.position_size > 0
shortPos = strategy.position_size < 0
inPos    = longPos or shortPos
tp1Price = longPos  ? entryPrice + partialTrigR * rDist :
           shortPos ? entryPrice - partialTrigR * rDist : na

plot(trendEma, "Trend EMA", color=color.new(color.blue, 0), linewidth=2)
plot(inPos and showLevels ? entryPrice : na, "Entry",      color=color.new(color.gray, 0),  style=plot.style_linebr, linewidth=2)
plot(inPos and showLevels ? curStop    : na, "Stop Loss",  color=color.new(color.red, 0),   style=plot.style_linebr, linewidth=2)
plot(inPos and showLevels and usePartial ? tp1Price : na, "Partial TP", color=color.new(color.teal, 0), style=plot.style_linebr, linewidth=1)
plot(inPos and showLevels ? finalTP    : na, "Target",     color=color.new(color.green, 0), style=plot.style_linebr, linewidth=2)

plotshape(longSignal  and canTrade and flat, "Long",  shape.triangleup,   location.belowbar, color.new(color.green,0), size=size.small)
plotshape(shortSignal and canTrade and flat, "Short", shape.triangledown, location.abovebar, color.new(color.red,0),   size=size.small)
bgcolor(useSession and not inSession ? color.new(color.gray, 90) : na, title="Out of session")

// entry marker labels with the actual levels
if showLevels and (longSignal or shortSignal) and canTrade and flat
    lvlStop = longSignal ? calcLongStop() : calcShortStop()
    lvlR    = math.abs(close - lvlStop)
    lvlTP   = longSignal ? close + lvlR * rrRatio : close - lvlR * rrRatio
    txt     = (longSignal ? "LONG\n" : "SHORT\n") + "Entry " + str.tostring(close, format.mintick) +
              "\nSL " + str.tostring(lvlStop, format.mintick) + "\nTP " + str.tostring(lvlTP, format.mintick)
    label.new(bar_index, longSignal ? low : high, txt,
              style=longSignal ? label.style_label_up : label.style_label_down,
              color=color.new(longSignal ? color.green : color.red, 20),
              textcolor=color.white, size=size.small)

// ---------------------------------------------------------------------
// DASHBOARD — info table (active trade + performance)
// ---------------------------------------------------------------------
// BUGFIX #1: user-defined functions must live in the GLOBAL scope (not inside
// the `if` block). f_row takes the table as a parameter to avoid forward refs.
// Every cell gets a solid dark background so white text is readable on a white
// chart (the previous version was invisible on the default light theme).
f_row(table t, int r, string k, string v) =>
    table.cell(t, 0, r, k, text_color=color.white, bgcolor=color.new(#1e222d, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(t, 1, r, v, text_color=color.white, bgcolor=color.new(#1e222d, 0), text_size=size.small, text_halign=text.align_right)

var table dash = table.new(position.top_right, 2, 14, border_width=1, border_color=color.new(color.gray, 40), frame_width=1, frame_color=color.new(color.gray, 0))
if barstate.islast and showStats
    pf      = strategy.grossloss != 0 ? strategy.grossprofit / strategy.grossloss : na
    winPct  = strategy.closedtrades > 0 ? strategy.wintrades / strategy.closedtrades * 100 : na
    netPct  = strategy.initial_capital > 0 ? strategy.netprofit / strategy.initial_capital * 100 : na
    ddPct   = strategy.initial_capital > 0 ? strategy.max_drawdown / strategy.initial_capital * 100 : na
    dir     = longPos ? "LONG" : shortPos ? "SHORT" : "FLAT"
    riskUsd = inPos ? math.abs(entryPrice - curStop) * math.abs(strategy.position_size) * syminfo.pointvalue : na
    hc      = color.new(#2a2e39, 0)   // header background (dark)
    dirBg   = longPos ? color.new(color.green, 0) : shortPos ? color.new(color.red, 0) : hc
    table.cell(dash, 0, 0, "ACTIVE TRADE", text_color=color.white, bgcolor=hc, text_size=size.small)
    table.cell(dash, 1, 0, dir,            text_color=color.white, bgcolor=dirBg, text_size=size.small)
    f_row(dash, 1,  "Entry",        inPos ? str.tostring(entryPrice, format.mintick) : "-")
    f_row(dash, 2,  "Stop loss",    inPos ? str.tostring(curStop,    format.mintick) : "-")
    f_row(dash, 3,  "Partial TP",   inPos and usePartial ? str.tostring(tp1Price, format.mintick) : "-")
    f_row(dash, 4,  "Target",       inPos ? str.tostring(finalTP,    format.mintick) : "-")
    f_row(dash, 5,  "Risk ($)",     inPos ? str.tostring(riskUsd, "#.##") : "-")
    f_row(dash, 6,  "Open PnL ($)", str.tostring(strategy.openprofit, "#.##"))
    table.cell(dash, 0, 7, "PERFORMANCE", text_color=color.white, bgcolor=hc, text_size=size.small)
    table.cell(dash, 1, 7, "",            text_color=color.white, bgcolor=hc, text_size=size.small)
    f_row(dash, 8,  "Net profit %",  str.tostring(netPct, "#.##"))
    f_row(dash, 9,  "Trades",        str.tostring(strategy.closedtrades))
    f_row(dash, 10, "Win %",         str.tostring(winPct, "#.##"))
    f_row(dash, 11, "Profit factor", str.tostring(pf, "#.##"))
    f_row(dash, 12, "Max DD %",      str.tostring(ddPct, "#.##"))
    f_row(dash, 13, "Cooldown",      coolingDown ? "ON" : str.tostring(consLosses) + "/" + str.tostring(maxConsLoss))
// =====================================================================
