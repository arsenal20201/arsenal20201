// ============================================================================
//  INSTITUTIONAL SMC CONFLUENCE ENGINE v2  —  Pine Script v6
// ============================================================================
//  A ground-up rebuild of the v1 confluence engine. Same non-repainting
//  design philosophy, same discretionary-trader mental model, but every
//  subsystem is now built the way a prop desk would build it:
//
//   * Trend is a PROBABILITY (adaptive-weighted composite of 8 factors),
//     not a single EMA cross.
//   * Market structure (HH/HL/LH/LL, BOS, CHoCH) is tracked on 6 timeframes
//     (M15/H1/H4/D/W/Mo) plus the chart TF, not just the chart TF.
//   * Liquidity is a ranked map of PDH/PDL, PWH/PWL, PMH/PML, Asia/London/NY
//     session extremes and equal highs/lows — not just "the last swing".
//   * Order Blocks only get created and are graded A+/A/B/C by how many of
//     {sweep, displacement, BOS, FVG, volume expansion} they actually have.
//   * FVGs are stored as an array of independent, aging, self-mitigating
//     zones instead of a single "latest gap" variable.
//   * Entries are a SEQUENCE (sweep -> CHoCH -> displacement -> OB -> FVG ->
//     volume -> trend -> regime) with a bar-count timeout, not "score > X".
//   * Risk is dynamic: structure/liquidity based SL & TP with an ATR
//     fallback, scaled by market regime and an asset profile.
//
//  NON-REPAINTING GUARANTEES (unchanged from v1, extended to every new HTF
//  call):
//   * All HTF reads use the PineCoders technique: compute the value inside a
//     function on the security context, shift the WHOLE returned tuple by
//     [1], and request with lookahead = barmerge.lookahead_on. This means a
//     higher-timeframe bar's data is only used once that HTF bar has fully
//     closed — verified historical == realtime behaviour.
//   * Requested HTFs are clamped to be >= the chart timeframe, because
//     request.security() cannot reliably serve a genuinely lower timeframe
//     than the chart (f_safeTf below).
//   * Pivots (ta.pivothigh/low) are, by construction, only confirmed
//     `pivotLen` bars after the fact.
//   * This is an analysis / decision-support tool, not financial advice.
//     Backtest and forward-test before risking capital.
// ============================================================================

//@version=6
indicator("Institutional SMC Confluence Engine v2", shorttitle="SMC-Engine v2", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500, max_bars_back=1000)

// ============================================================================
//  SECTION 0 — TYPE DEFINITIONS
// ============================================================================

type OB
    float  top
    float  bot
    int    dir           // +1 bullish, -1 bearish
    int    barIdx
    bool   mitigated = false
    string grade
    int    confluence
    box    zoneBox

type FVG
    float  top
    float  bot
    int    dir
    int    barIdx
    bool   mitigated = false
    float  mitigPct  = 0.0
    float  strength
    float  probability
    box    zoneBox

// ============================================================================
//  SECTION 1 — INPUTS
// ============================================================================

grpGen      = "═══ General ═══"
minRR       = input.float(2.0, "Minimum Risk:Reward", minval=1.0, step=0.1, group=grpGen)
probFloor   = input.int(60, "Minimum probability floor (%)", minval=50, maxval=95, group=grpGen, tooltip="Extra sanity floor on top of the entry pipeline: the trend-probability engine must clear this before a completed pipeline can fire.")
showZones   = input.bool(true, "Show OB / FVG / swing zones", group=grpGen)
showSR      = input.bool(true, "Show dynamic Support / Resistance", group=grpGen)
showBg      = input.bool(true, "Trend background", group=grpGen)

grpAsset    = "═══ Asset Profile ═══"
assetProfile = input.string("Auto", "Asset profile", options=["Auto","Forex","Gold","Crypto","Indices","Stocks"], group=grpAsset, tooltip="Auto-scales SL distance, equal-H/L tolerance and the volume engine's weight per instrument class.")

grpMTF      = "═══ Multi-Timeframe Trend ═══"
emaFastLen  = input.int(50,  "Trend EMA fast", minval=2, group=grpMTF)
emaSlowLen  = input.int(200, "Trend EMA slow", minval=5, group=grpMTF)
lrLen       = input.int(21, "Linear regression length", minval=5, group=grpMTF)
hullLen     = input.int(34, "Hull MA length", minval=5, group=grpMTF)
adaptEvalBars = input.int(10, "Adaptive weighting: evaluation horizon (bars)", minval=3, maxval=50, group=grpMTF, tooltip="How many bars ahead each trend factor's directional call is checked against realized price movement to update its adaptive weight.")
adaptAlpha  = input.float(0.05, "Adaptive weighting: learning rate", minval=0.01, maxval=0.5, step=0.01, group=grpMTF)

grpMS       = "═══ Market Structure ═══"
pivotLen    = input.int(8, "Chart-TF swing pivot length", minval=2, maxval=50, group=grpMS)
msPivotLen  = input.int(5, "HTF structure pivot length", minval=2, maxval=20, group=grpMS)
showStruct  = input.bool(true, "Show BOS / CHoCH labels", group=grpMS)
showSweeps  = input.bool(true, "Show liquidity-sweep labels", group=grpMS)
showHtfPanel = input.bool(true, "Show HTF structure matrix on dashboard", group=grpMS)

grpLQ       = "═══ Liquidity ═══"
eqTol       = input.float(0.10, "Equal H/L tolerance (× ATR)", minval=0.0, step=0.05, group=grpLQ)
showLiqLines = input.bool(true, "Show liquidity levels (PDH/PDL, sessions...)", group=grpLQ)

grpSess     = "═══ Sessions ═══"
useSession  = input.bool(false, "Trade only inside sessions", group=grpSess)
sessAsia    = input.session("2200-0600", "Asia session",   group=grpSess)
sessLondon  = input.session("0700-1600", "London session", group=grpSess)
sessNY      = input.session("1300-2200", "New York session", group=grpSess)
sessTz      = input.string("GMT", "Sessions timezone", group=grpSess)

grpVol      = "═══ Volume Engine ═══"
volLen      = input.int(20, "Volume average length", minval=2, group=grpVol)
volMult     = input.float(1.0, "Volume multiplier (confirm)", minval=0.1, step=0.1, group=grpVol)
volSpikeMult = input.float(1.5, "Volume spike multiplier", minval=1.0, step=0.1, group=grpVol)
volInst     = input.float(2.0, "Institutional volume multiplier", minval=1.0, step=0.1, group=grpVol)

grpATR      = "═══ ATR / Volatility ═══"
atrLen      = input.int(14, "ATR length", minval=2, group=grpATR)
atrMaLen    = input.int(20, "ATR average length", minval=2, group=grpATR)
slAtrMult   = input.float(1.5, "Stop-loss ATR multiple (fallback)", minval=0.1, step=0.1, group=grpATR)
trailMult   = input.float(2.0, "ATR trailing-stop multiple", minval=0.1, step=0.1, group=grpATR)
beTriggerR  = input.float(1.0, "Break-even trigger (R multiple)", minval=0.2, step=0.1, group=grpATR)

grpADX      = "═══ ADX ═══"
adxLen      = input.int(14, "ADX/DI length", minval=2, group=grpADX)
adxMin      = input.float(25.0, "ADX minimum (trend)", minval=0.0, step=0.5, group=grpADX)

grpRSI      = "═══ RSI ═══"
rsiLen      = input.int(14, "RSI length", minval=2, group=grpRSI)

grpRegime   = "═══ Market Regime ═══"
bbLen       = input.int(20, "Squeeze: BB length", minval=5, group=grpRegime)
bbMult      = input.float(2.0, "Squeeze: BB mult", minval=0.5, step=0.1, group=grpRegime)
atrPctLen   = input.int(100, "ATR percentile lookback", minval=20, maxval=500, group=grpRegime)
allowTrending   = input.bool(true,  "Allow entries: Trending",   group=grpRegime)
allowExpansion  = input.bool(true,  "Allow entries: Expansion",  group=grpRegime)
allowRanging    = input.bool(false, "Allow entries: Ranging",    group=grpRegime)
allowCompression= input.bool(false, "Allow entries: Compression",group=grpRegime)
allowVolatile   = input.bool(false, "Allow entries: Volatile",   group=grpRegime)
allowLowVol     = input.bool(false, "Allow entries: Low Volatility", group=grpRegime)

grpOB       = "═══ Order Block / FVG Engine ═══"
dispAtrMult = input.float(1.2, "Displacement candle ATR multiple", minval=0.5, step=0.1, group=grpOB)
maxOB       = input.int(8, "Max stored order blocks (per side)", minval=2, maxval=20, group=grpOB)
maxFVG      = input.int(8, "Max stored FVGs (per side)", minval=2, maxval=20, group=grpOB)
minGrade    = input.string("B", "Minimum OB grade to display / trade", options=["A+","A","B","C"], group=grpOB)

grpEntry    = "═══ Entry Engine ═══"
pipelineWindow = input.int(30, "Pipeline max bars (sweep → entry)", minval=5, maxval=150, group=grpEntry)
reqStruct   = input.bool(false, "Require matching chart-TF structure at CHoCH stage", group=grpEntry)

grpUI       = "═══ Dashboard & Colors ═══"
showDash    = input.bool(true, "Show dashboard", group=grpUI)
showStats   = input.bool(true, "Show statistics panel", group=grpUI)
dashPos     = input.string("Top Right", "Dashboard position", options=["Top Right","Top Left","Bottom Right","Bottom Left","Middle Right"], group=grpUI)
colBull     = input.color(color.new(#089981, 0), "Bullish", group=grpUI)
colBear     = input.color(color.new(#f23645, 0), "Bearish", group=grpUI)
colOB       = input.color(color.new(#2962ff, 0), "Order block", group=grpUI)
colFvg      = input.color(color.new(#ff9800, 0), "Fair value gap", group=grpUI)
colLiq      = input.color(color.new(#9c27b0, 0), "Liquidity level", group=grpUI)

grpAl       = "═══ Alerts ═══"
alOn        = input.bool(true, "Enable rich alert() messages", group=grpAl)

// ============================================================================
//  SECTION 2 — CORE INDICATORS
// ============================================================================

atr      = ta.atr(atrLen)
atrMa    = ta.sma(atr, atrMaLen)
rsi      = ta.rsi(close, rsiLen)
volAvg   = ta.sma(volume, volLen)
vwap     = ta.vwap(hlc3)
emaFast  = ta.ema(close, emaFastLen)
emaSlow  = ta.ema(close, emaSlowLen)
hullMA   = ta.hma(close, hullLen)
lrVal    = ta.linreg(close, lrLen, 0)
lrSlope  = lrVal - lrVal[1]
[diPlus, diMinus, adx] = ta.dmi(adxLen, adxLen)
diBullish = diPlus > diMinus

bodySz   = math.abs(close - open)
rangeSz  = high - low
upWick   = high - math.max(close, open)
dnWick   = math.min(close, open) - low

atrOk    = atr > atrMa
adxOk    = adx > adxMin

// ============================================================================
//  SECTION 3 — ASSET PROFILE
// ============================================================================

f_autoAsset() =>
    tk = syminfo.ticker
    isGold = str.contains(tk, "XAU") or str.contains(tk, "GOLD")
    t = syminfo.type
    isGold ? "Gold" : t == "crypto" ? "Crypto" : t == "forex" ? "Forex" : t == "index" ? "Indices" : "Stocks"

activeProfile = assetProfile == "Auto" ? f_autoAsset() : assetProfile

f_profileParams(_p) =>
    sl = _p == "Forex" ? 1.2 : _p == "Gold" ? 1.6 : _p == "Crypto" ? 1.8 : _p == "Indices" ? 1.4 : _p == "Stocks" ? 1.3 : 1.5
    eq = _p == "Forex" ? 1.0 : _p == "Gold" ? 1.3 : _p == "Crypto" ? 1.5 : _p == "Indices" ? 1.1 : _p == "Stocks" ? 1.0 : 1.0
    vw = _p == "Forex" ? 0.6 : _p == "Gold" ? 0.7 : _p == "Crypto" ? 1.0 : _p == "Indices" ? 0.9 : _p == "Stocks" ? 1.0 : 0.8
    [sl, eq, vw]

[profSlMult, profEqTolMult, profVolWeight] = f_profileParams(activeProfile)

// ============================================================================
//  SECTION 4 — HEIKIN ASHI (internal, chart-type independent)
// ============================================================================

var float haOpen = na
haClose = (open + high + low + close) / 4.0
haOpen := na(haOpen[1]) ? (open + close) / 2.0 : (nz(haOpen[1]) + nz(haClose[1])) / 2.0
haHigh  = math.max(high, math.max(haOpen, haClose))
haLow   = math.min(low,  math.min(haOpen, haClose))
haBull  = haClose > haOpen
haBody  = math.abs(haClose - haOpen)
haAvgBody = ta.sma(haBody, 14)

var int haBullRun = 0
var int haBearRun = 0
haBullRun := haBull ? nz(haBullRun[1]) + 1 : 0
haBearRun := (not haBull) ? nz(haBearRun[1]) + 1 : 0
haBuyOk  = haBull and haBullRun >= 2
haSellOk = (not haBull) and haBearRun >= 2

// ============================================================================
//  SECTION 5 — CANDLE ENGINE
// ============================================================================

pinBarBull   = rangeSz > 0 and dnWick > bodySz * 2   and upWick < bodySz * 0.5
pinBarBear   = rangeSz > 0 and upWick > bodySz * 2   and dnWick < bodySz * 0.5
engulfBull   = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
engulfBear   = close < open and close[1] > open[1] and close <= open[1] and open >= close[1]
insideBar    = high < high[1] and low > low[1]
outsideBar   = high > high[1] and low < low[1]
marubozuBull = close > open and (upWick + dnWick) < bodySz * 0.1
marubozuBear = close < open and (upWick + dnWick) < bodySz * 0.1
rejectionBull = dnWick > bodySz * 1.5 and close > open
rejectionBear = upWick > bodySz * 1.5 and close < open
compressionCandle = rangeSz < atr * 0.5
// Displacement = a big-bodied impulse candle OR any other high-conviction
// candle-engine pattern (engulfing, marubozu, a sharp rejection wick) that a
// discretionary SMC trader would also read as "the move is real".
dispUpCandle = (close > open and bodySz > atr * dispAtrMult) or engulfBull or marubozuBull or (rejectionBull and bodySz > atr * 0.8)
dispDnCandle = (close < open and bodySz > atr * dispAtrMult) or engulfBear or marubozuBear or (rejectionBear and bodySz > atr * 0.8)

f_candlePattern() =>
    pinBarBull ? "Pin Bar Bull" : pinBarBear ? "Pin Bar Bear" : engulfBull ? "Engulfing Bull" : engulfBear ? "Engulfing Bear" : marubozuBull ? "Marubozu Bull" : marubozuBear ? "Marubozu Bear" : outsideBar ? "Outside Bar" : insideBar ? "Inside Bar" : compressionCandle ? "Compression" : "—"

// ============================================================================
//  SECTION 6 — VOLUME ENGINE
// ============================================================================

relVol       = volAvg > 0 ? volume / volAvg : 1.0
volOk        = volume > volAvg * volMult
volInstit    = volume > volAvg * volInst
volumeSpike  = relVol > volSpikeMult
volDryUp     = ta.sma(relVol, 10) < 0.6
absorption   = relVol > 1.5 and rangeSz < atr * 0.6
climaxUp     = volumeSpike and close > open and upWick > bodySz * 0.8
climaxDn     = volumeSpike and close < open and dnWick > bodySz * 0.8
effortResult = rangeSz > 0 ? relVol / math.max(rangeSz / atr, 0.01) : relVol

adMult = rangeSz > 0 ? ((close - low) - (high - close)) / rangeSz : 0.0
var float adLine = 0.0
adLine := adLine + adMult * volume
accumulating = adLine > adLine[5]
distributing = adLine < adLine[5]

instVolScoreRaw = (relVol * 30) + (volumeSpike ? 20 : 0) + (absorption ? 15 : 0) + (accumulating ? 10 : distributing ? -10 : 0) + 25
instVolScore = math.round(math.max(0, math.min(100, instVolScoreRaw)) * profVolWeight)

// ============================================================================
//  SECTION 7 — MARKET REGIME DETECTION
// ============================================================================

bbBasis    = ta.sma(close, bbLen)
bbDev      = bbMult * ta.stdev(close, bbLen)
bbWidth    = bbBasis != 0 ? (bbDev * 2) / bbBasis : 0.0
bbWidthAvg = ta.sma(bbWidth, bbLen)
squeezeOn  = bbWidth < bbWidthAvg * 0.7
atrPct     = ta.percentrank(atr, atrPctLen)

regime = squeezeOn ? "Compression" : atrPct >= 90 ? "Volatile" : atrPct >= 80 ? "Expansion" : adx >= adxMin ? "Trending" : atrPct <= 20 ? "Low Volatility" : "Ranging"

regimeCol = regime == "Trending" ? colBull : regime == "Expansion" ? color.orange : regime == "Volatile" ? color.red : regime == "Compression" ? color.purple : regime == "Low Volatility" ? color.gray : color.silver

regimeOk = switch regime
    "Trending"      => allowTrending
    "Expansion"     => allowExpansion
    "Ranging"       => allowRanging
    "Compression"   => allowCompression
    "Volatile"      => allowVolatile
    "Low Volatility"=> allowLowVol
    => false

// ============================================================================
//  SECTION 8 — MARKET STRUCTURE (chart timeframe): HH/HL/LH/LL, BOS, CHoCH
// ============================================================================

ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low,  pivotLen, pivotLen)

var float lastPH = na
var float prevPH = na
var float lastPL = na
var float prevPL = na
var int   structDir = 0
var bool  phBroken = true
var bool  plBroken = true
var string lastSwingType = "—"

bosUp = false
bosDn = false
chochUp = false
chochDn = false

if not na(ph)
    prevPH := lastPH
    lastPH := ph
    phBroken := false
    lastSwingType := na(prevPH) ? "HH" : (ph > prevPH ? "HH" : "LH")
if not na(pl)
    prevPL := lastPL
    lastPL := pl
    plBroken := false
    lastSwingType := na(prevPL) ? "HL" : (pl > prevPL ? "HL" : "LL")

if not na(lastPH) and not phBroken and close > lastPH
    chochUp := structDir < 0
    bosUp   := structDir >= 0
    structDir := 1
    phBroken := true
if not na(lastPL) and not plBroken and close < lastPL
    chochDn := structDir > 0
    bosDn   := structDir <= 0
    structDir := -1
    plBroken := true

msBull = structDir == 1
msBear = structDir == -1

// ============================================================================
//  SECTION 9 — MULTI-TIMEFRAME STRUCTURE MATRIX (M15 / H1 / H4 / D / W / Mo)
// ============================================================================
//  Every HTF read goes through f_htfPack() -> f_htf(): the whole return
//  tuple is history-shifted by [1] and pulled with lookahead_on, so a value
//  is only visible after its own HTF bar has fully closed (see header note).

f_safeTf(_tf) =>
    timeframe.in_seconds(_tf) < timeframe.in_seconds(timeframe.period) ? timeframe.period : _tf

f_htfPack(_tf) =>
    ef = ta.ema(close, emaFastLen)
    es = ta.ema(close, emaSlowLen)
    vote = (ef > es ? 1 : -1) + (close > ef ? 1 : -1) + (ef > ef[3] ? 1 : -1)
    trendDir = vote > 0 ? 1 : vote < 0 ? -1 : 0
    ph2 = ta.pivothigh(high, msPivotLen, msPivotLen)
    pl2 = ta.pivotlow(low,  msPivotLen, msPivotLen)
    var float lph = na
    var float pph = na
    var float lpl = na
    var float ppl = na
    var int    sd  = 0
    var bool   phB = true
    var bool   plB = true
    var int    swc = 0
    bool bU = false
    bool bD = false
    bool cU = false
    bool cD = false
    if not na(ph2)
        pph := lph
        lph := ph2
        phB := false
        swc := na(pph) ? 1 : (ph2 > pph ? 1 : 3)   // 1=HH 3=LH
    if not na(pl2)
        ppl := lpl
        lpl := pl2
        plB := false
        swc := na(ppl) ? 2 : (pl2 > ppl ? 2 : 4)   // 2=HL 4=LL
    if not na(lph) and not phB and close > lph
        cU := sd < 0
        bU := sd >= 0
        sd := 1
        phB := true
    if not na(lpl) and not plB and close < lpl
        cD := sd > 0
        bD := sd <= 0
        sd := -1
        plB := true
    [trendDir, sd, bU, bD, cU, cD, lph, lpl, high[1], low[1], swc]

f_htf(_tf) =>
    tf = f_safeTf(_tf)
    [td, sd, bU, bD, cU, cD, lph, lpl, ph1, pl1, swc] = f_htfPack(tf)
    request.security(syminfo.tickerid, tf, [td[1], sd[1], bU[1], bD[1], cU[1], cD[1], lph[1], lpl[1], ph1[1], pl1[1], swc[1]], lookahead=barmerge.lookahead_on)

[m15Td, m15Sd, m15BU, m15BD, m15CU, m15CD, m15LPH, m15LPL, m15PH1, m15PL1, m15SWC] = f_htf("15")
[h1Td,  h1Sd,  h1BU,  h1BD,  h1CU,  h1CD,  h1LPH,  h1LPL,  h1PH1,  h1PL1,  h1SWC ] = f_htf("60")
[h4Td,  h4Sd,  h4BU,  h4BD,  h4CU,  h4CD,  h4LPH,  h4LPL,  h4PH1,  h4PL1,  h4SWC ] = f_htf("240")
[dTd,   dSd,   dBU,   dBD,   dCU,   dCD,   dLPH,   dLPL,   dPH1,   dPL1,   dSWC  ] = f_htf("D")
[wTd,   wSd,   wBU,   wBD,   wCU,   wCD,   wLPH,   wLPL,   wPH1,   wPL1,   wSWC  ] = f_htf("W")
[moTd,  moSd,  moBU,  moBD,  moCU,  moCD,  moLPH,  moLPL,  moPH1,  moPL1,  moSWC ] = f_htf("M")

f_swc(_c) => _c == 1 ? "HH" : _c == 2 ? "HL" : _c == 3 ? "LH" : _c == 4 ? "LL" : "—"

// Previous-period highs/lows for the liquidity engine (Section 11)
pdh = dPH1
pdl = dPL1
pwh = wPH1
pwl = wPL1
pmh = moPH1
pml = moPL1

// Net alignment across the 6 HTFs (trend vote), used by the probability engine
htfTrendVotes = m15Td + h1Td + h4Td + dTd + wTd + moTd
htfStructVotes = (m15Sd == 1 ? 1 : m15Sd == -1 ? -1 : 0) + (h1Sd == 1 ? 1 : h1Sd == -1 ? -1 : 0) + (h4Sd == 1 ? 1 : h4Sd == -1 ? -1 : 0) + (dSd == 1 ? 1 : dSd == -1 ? -1 : 0) + (wSd == 1 ? 1 : wSd == -1 ? -1 : 0) + (moSd == 1 ? 1 : moSd == -1 ? -1 : 0)
mtfBullCnt = (m15Td==1?1:0)+(h1Td==1?1:0)+(h4Td==1?1:0)+(dTd==1?1:0)+(wTd==1?1:0)+(moTd==1?1:0)
mtfBearCnt = (m15Td==-1?1:0)+(h1Td==-1?1:0)+(h4Td==-1?1:0)+(dTd==-1?1:0)+(wTd==-1?1:0)+(moTd==-1?1:0)
mtfBull = mtfBullCnt >= 3 and mtfBullCnt >= mtfBearCnt
mtfBear = mtfBearCnt >= 3 and mtfBearCnt >= mtfBullCnt
buyTrendOk  = mtfBearCnt < 5
sellTrendOk = mtfBullCnt < 5

// ============================================================================
//  SECTION 10 — TREND / PROBABILITY ENGINE  (adaptive-weighted, 0-100)
// ============================================================================
//  8 directional factors, each a signed vote in {-1,0,1}. Every factor keeps
//  a running "hit accuracy" (adaptAlpha-smoothed) measured against realized
//  price direction `adaptEvalBars` later. Weights scale with that accuracy,
//  so factors that have recently been right count for more — a genuine
//  adaptive-weighting scheme, not a fixed 20/20/15... split.

f1_ema     = emaFast > emaSlow ? 1 : emaFast < emaSlow ? -1 : 0
f2_slope   = math.sign(emaFast - emaFast[5])
f3_lr      = math.sign(lrSlope)
f4_hull    = math.sign(hullMA - hullMA[1])
f5_fractal = structDir
f6_mom     = math.sign(rsi - 50)
f7_atrExp  = atrOk ? math.sign(close - close[3]) : 0
f8_mtf     = math.sign(htfTrendVotes)

outcomeNow = close - close[adaptEvalBars] > 0 ? 1 : close - close[adaptEvalBars] < 0 ? -1 : 0

f_adaptAcc(_accPrev, _factorPast) =>
    hit = _factorPast != 0 and _factorPast == outcomeNow
    miss = _factorPast != 0 and _factorPast != outcomeNow
    hit ? _accPrev + adaptAlpha * (1.0 - _accPrev) : miss ? _accPrev + adaptAlpha * (0.0 - _accPrev) : _accPrev

var float acc1 = 0.5
var float acc2 = 0.5
var float acc3 = 0.5
var float acc4 = 0.5
var float acc5 = 0.5
var float acc6 = 0.5
var float acc7 = 0.5
var float acc8 = 0.5
acc1 := f_adaptAcc(acc1, f1_ema[adaptEvalBars])
acc2 := f_adaptAcc(acc2, f2_slope[adaptEvalBars])
acc3 := f_adaptAcc(acc3, f3_lr[adaptEvalBars])
acc4 := f_adaptAcc(acc4, f4_hull[adaptEvalBars])
acc5 := f_adaptAcc(acc5, f5_fractal[adaptEvalBars])
acc6 := f_adaptAcc(acc6, f6_mom[adaptEvalBars])
acc7 := f_adaptAcc(acc7, f7_atrExp[adaptEvalBars])
acc8 := f_adaptAcc(acc8, f8_mtf[adaptEvalBars])

// Base weights sum to 8 (equal start); adaptive multiplier re-weights them.
w1 = 0.5 + acc1
w2 = 0.5 + acc2
w3 = 0.5 + acc3
w4 = 0.5 + acc4
w5 = 0.5 + acc5
w6 = 0.5 + acc6
w7 = 0.5 + acc7
w8 = 0.5 + acc8
wSum = w1 + w2 + w3 + w4 + w5 + w6 + w7 + w8

compositeSum = w1*f1_ema + w2*f2_slope + w3*f3_lr + w4*f4_hull + w5*f5_fractal + w6*f6_mom + w7*f7_atrExp + w8*f8_mtf
trendProbability = wSum > 0 ? 50 + 50 * (compositeSum / wSum) : 50.0
trendProbBull = trendProbability          // 0-100 probability the bias is bullish
trendProbBear = 100 - trendProbability    // 0-100 probability the bias is bearish

trendStrengthTxt = trendProbability >= 70 ? "Strong Bullish" : trendProbability >= 55 ? "Bullish" : trendProbability <= 30 ? "Strong Bearish" : trendProbability <= 45 ? "Bearish" : "Neutral"

// ============================================================================
//  SECTION 11 — LIQUIDITY ENGINE
// ============================================================================

eqTolPrice = eqTol * profEqTolMult * atr
equalHighs = not na(lastPH) and not na(prevPH) and math.abs(lastPH - prevPH) <= eqTolPrice
equalLows  = not na(lastPL) and not na(prevPL) and math.abs(lastPL - prevPL) <= eqTolPrice

sweepBull = not na(lastPL) and low < lastPL and close > lastPL and close > open
sweepBear = not na(lastPH) and high > lastPH and close < lastPH and close < open

// Session extremes: tracked live during the session, frozen at session close.
inAsiaSess   = not na(time(timeframe.period, sessAsia,   sessTz))
inLondonSess = not na(time(timeframe.period, sessLondon, sessTz))
inNYSess     = not na(time(timeframe.period, sessNY,     sessTz))
inOverlap    = inLondonSess and inNYSess
sessionOk    = not useSession or inLondonSess or inNYSess
sessionName  = inOverlap ? "LDN/NY Overlap" : inLondonSess ? "London" : inNYSess ? "New York" : inAsiaSess ? "Asia" : "Off-session"

var float asiaHigh = na
var float asiaLow  = na
var float asiaHighPrev = na
var float asiaLowPrev  = na
newAsia = inAsiaSess and not inAsiaSess[1]
if newAsia
    asiaHighPrev := asiaHigh
    asiaLowPrev  := asiaLow
    asiaHigh := high
    asiaLow  := low
else if inAsiaSess
    asiaHigh := math.max(nz(asiaHigh, high), high)
    asiaLow  := math.min(nz(asiaLow, low), low)

var float londonHigh = na
var float londonLow  = na
var float londonHighPrev = na
var float londonLowPrev  = na
newLondon = inLondonSess and not inLondonSess[1]
if newLondon
    londonHighPrev := londonHigh
    londonLowPrev  := londonLow
    londonHigh := high
    londonLow  := low
else if inLondonSess
    londonHigh := math.max(nz(londonHigh, high), high)
    londonLow  := math.min(nz(londonLow, low), low)

var float nyHigh = na
var float nyLow  = na
var float nyHighPrev = na
var float nyLowPrev  = na
newNY = inNYSess and not inNYSess[1]
if newNY
    nyHighPrev := nyHigh
    nyLowPrev  := nyLow
    nyHigh := high
    nyLow  := low
else if inNYSess
    nyHigh := math.max(nz(nyHigh, high), high)
    nyLow  := math.min(nz(nyLow, low), low)

// Internal vs external liquidity (relative to the current dealing range)
externalHighLiq = lastPH
externalLowLiq  = lastPL
internalHighLiq = prevPH
internalLowLiq  = prevPL

// Ranked liquidity pool map (rebuilt every bar — small fixed set, cheap).
var string[] liqNames  = array.new<string>()
var float[]  liqPrices = array.new<float>()
var int[]    liqRank   = array.new<int>()

f_addLiq(_name, _price, _rank) =>
    if not na(_price)
        array.push(liqNames, _name)
        array.push(liqPrices, _price)
        array.push(liqRank, _rank)

array.clear(liqNames)
array.clear(liqPrices)
array.clear(liqRank)
f_addLiq("PMH", pmh, 6)
f_addLiq("PML", pml, 6)
f_addLiq("PWH", pwh, 5)
f_addLiq("PWL", pwl, 5)
f_addLiq("PDH", pdh, 4)
f_addLiq("PDL", pdl, 4)
f_addLiq("Asia H", asiaHighPrev, 2)
f_addLiq("Asia L", asiaLowPrev, 2)
f_addLiq("London H", londonHighPrev, 3)
f_addLiq("London L", londonLowPrev, 3)
f_addLiq("NY H", nyHighPrev, 3)
f_addLiq("NY L", nyLowPrev, 3)
f_addLiq("EQH", equalHighs ? lastPH : na, 3)
f_addLiq("EQL", equalLows  ? lastPL : na, 3)
f_addLiq("Ext High", externalHighLiq, 4)
f_addLiq("Ext Low",  externalLowLiq, 4)
f_addLiq("Int High", internalHighLiq, 1)
f_addLiq("Int Low",  internalLowLiq, 1)

f_nearestLiq(_above) =>
    float bestPrice = na
    int bestRank = -1
    string bestName = "—"
    if array.size(liqPrices) > 0
        for i = 0 to array.size(liqPrices) - 1
            p = array.get(liqPrices, i)
            if not na(p) and ((_above and p > close) or (not _above and p < close))
                if na(bestPrice) or (_above and p < bestPrice) or (not _above and p > bestPrice)
                    bestPrice := p
                    bestRank := array.get(liqRank, i)
                    bestName := array.get(liqNames, i)
    [bestPrice, bestRank, bestName]

[liqTargetUp, liqTargetUpRank, liqTargetUpName] = f_nearestLiq(true)
[liqTargetDn, liqTargetDnRank, liqTargetDnName] = f_nearestLiq(false)

f_nearestPoolTag(_price) =>
    string tag = ""
    if array.size(liqPrices) > 0
        for i = 0 to array.size(liqPrices) - 1
            p = array.get(liqPrices, i)
            if not na(p) and math.abs(p - _price) <= eqTolPrice
                tag := array.get(liqNames, i)
    tag

sweepBullTag = sweepBull ? f_nearestPoolTag(low) : ""
sweepBearTag = sweepBear ? f_nearestPoolTag(high) : ""

// ============================================================================
//  SECTION 12 — FAIR VALUE GAP ENGINE  (multi-instance, aging, self-mitigating)
// ============================================================================

var FVG[] bullFvgs = array.new<FVG>()
var FVG[] bearFvgs = array.new<FVG>()

bullFvgNew = low > high[2]
bearFvgNew = high < low[2]

f_fvgProbability(_dir) =>
    base = 50.0
    base += (_dir == 1 and trendProbability >= 55) or (_dir == -1 and trendProbability <= 45) ? 20 : 0
    base += volOk ? 15 : 0
    base += (_dir == 1 and msBull) or (_dir == -1 and msBear) ? 15 : 0
    math.min(100, base)

if showZones and bullFvgNew
    top = low
    bot = high[2]
    gSize = top - bot
    b = box.new(bar_index - 2, top, bar_index + 20, bot, border_color=na, bgcolor=color.new(colFvg, 82))
    f = FVG.new(top=top, bot=bot, dir=1, barIdx=bar_index, strength=gSize / atr, probability=f_fvgProbability(1), zoneBox=b)
    array.push(bullFvgs, f)
    if array.size(bullFvgs) > maxFVG
        old = array.shift(bullFvgs)
        box.delete(old.zoneBox)

if showZones and bearFvgNew
    top = low[2]
    bot = high
    gSize = top - bot
    b = box.new(bar_index - 2, top, bar_index + 20, bot, border_color=na, bgcolor=color.new(colFvg, 82))
    f = FVG.new(top=top, bot=bot, dir=-1, barIdx=bar_index, strength=gSize / atr, probability=f_fvgProbability(-1), zoneBox=b)
    array.push(bearFvgs, f)
    if array.size(bearFvgs) > maxFVG
        old = array.shift(bearFvgs)
        box.delete(old.zoneBox)

f_updateFvgs(array<FVG> arr, bool isBull) =>
    touched = false
    if array.size(arr) > 0
        for i = array.size(arr) - 1 to 0
            g = array.get(arr, i)
            if not g.mitigated
                gRange = g.top - g.bot
                if isBull
                    if low <= g.top and high >= g.bot
                        touched := true
                    if low <= g.bot
                        g.mitigated := true
                        g.mitigPct := 1.0
                        box.delete(g.zoneBox)
                        array.remove(arr, i)
                    else if gRange > 0 and low < g.top
                        g.mitigPct := math.min(1.0, (g.top - low) / gRange)
                else
                    if high >= g.bot and low <= g.top
                        touched := true
                    if high >= g.top
                        g.mitigated := true
                        g.mitigPct := 1.0
                        box.delete(g.zoneBox)
                        array.remove(arr, i)
                    else if gRange > 0 and high > g.bot
                        g.mitigPct := math.min(1.0, (high - g.bot) / gRange)
    touched

inBullFvg = f_updateFvgs(bullFvgs, true)
inBearFvg = f_updateFvgs(bearFvgs, false)

// ============================================================================
//  SECTION 13 — ORDER BLOCK ENGINE  (graded A+/A/B/C)
// ============================================================================

var OB[] bullOBs = array.new<OB>()
var OB[] bearOBs = array.new<OB>()

sweepBullRecent = ta.barssince(sweepBull) <= 10
sweepBearRecent = ta.barssince(sweepBear) <= 10

impulseUp = (bosUp or chochUp) and dispUpCandle
impulseDn = (bosDn or chochDn) and dispDnCandle

bullConfluence = (sweepBullRecent ? 1 : 0) + (dispUpCandle ? 1 : 0) + ((bosUp or chochUp) ? 1 : 0) + ((bullFvgNew or inBullFvg) ? 1 : 0) + (volOk ? 1 : 0)
bearConfluence = (sweepBearRecent ? 1 : 0) + (dispDnCandle ? 1 : 0) + ((bosDn or chochDn) ? 1 : 0) + ((bearFvgNew or inBearFvg) ? 1 : 0) + (volOk ? 1 : 0)

f_grade(_cnt) =>
    _cnt >= 5 ? "A+" : _cnt == 4 ? "A" : _cnt == 3 ? "B" : _cnt == 2 ? "C" : "—"

f_gradeRank(_g) =>
    _g == "A+" ? 4 : _g == "A" ? 3 : _g == "B" ? 2 : _g == "C" ? 1 : 0

minGradeRank = f_gradeRank(minGrade)

if showZones and impulseUp and close[1] < open[1] and bullConfluence >= 2
    grade = f_grade(bullConfluence)
    if f_gradeRank(grade) >= minGradeRank
        b = box.new(bar_index - 1, high[1], bar_index + 20, low[1], border_color=colOB, bgcolor=color.new(colOB, 80))
        ob = OB.new(top=high[1], bot=low[1], dir=1, barIdx=bar_index, grade=grade, confluence=bullConfluence, zoneBox=b)
        array.push(bullOBs, ob)
        if array.size(bullOBs) > maxOB
            old = array.shift(bullOBs)
            box.delete(old.zoneBox)

if showZones and impulseDn and close[1] > open[1] and bearConfluence >= 2
    grade = f_grade(bearConfluence)
    if f_gradeRank(grade) >= minGradeRank
        b = box.new(bar_index - 1, high[1], bar_index + 20, low[1], border_color=colBear, bgcolor=color.new(colBear, 80))
        ob = OB.new(top=high[1], bot=low[1], dir=-1, barIdx=bar_index, grade=grade, confluence=bearConfluence, zoneBox=b)
        array.push(bearOBs, ob)
        if array.size(bearOBs) > maxOB
            old = array.shift(bearOBs)
            box.delete(old.zoneBox)

f_touchUnmitigated(array<OB> arr, bool isBull) =>
    touched = false
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            ob = array.get(arr, i)
            if not ob.mitigated and low <= ob.top and high >= ob.bot
                touched := true
                if isBull and low <= ob.bot
                    ob.mitigated := true
                    box.set_bgcolor(ob.zoneBox, color.new(color.gray, 92))
                if not isBull and high >= ob.top
                    ob.mitigated := true
                    box.set_bgcolor(ob.zoneBox, color.new(color.gray, 92))
    touched

inBullOb = f_touchUnmitigated(bullOBs, true)
inBearOb = f_touchUnmitigated(bearOBs, false)

f_latestUnmitigated(array<OB> arr) =>
    float t = na
    float b = na
    string g = "—"
    if array.size(arr) > 0
        for i = array.size(arr) - 1 to 0
            ob = array.get(arr, i)
            if not ob.mitigated
                t := ob.top
                b := ob.bot
                g := ob.grade
                break
    [t, b, g]

[bullObTop, bullObBot, bullObGrade] = f_latestUnmitigated(bullOBs)
[bearObTop, bearObBot, bearObGrade] = f_latestUnmitigated(bearOBs)

// ============================================================================
//  SECTION 14 — SUPPORT / RESISTANCE  &  S/R GUARD
// ============================================================================

var line srResLine = na
var line srSupLine = na
if showSR and not na(ph)
    line.delete(srResLine)
    srResLine := line.new(bar_index - pivotLen, ph, bar_index, ph, color=colBear, width=2, extend=extend.right)
if showSR and not na(pl)
    line.delete(srSupLine)
    srSupLine := line.new(bar_index - pivotLen, pl, bar_index, pl, color=colBull, width=2, extend=extend.right)

nearRes = not na(lastPH) and not phBroken and (lastPH - close) <= atr and close < lastPH
nearSup = not na(lastPL) and not plBroken and (close - lastPL) <= atr and close > lastPL

// ============================================================================
//  SECTION 15 — ENTRY ENGINE  (sequential pipeline with timeout)
// ============================================================================
//  sweep -> CHoCH -> displacement -> OB -> FVG -> volume -> trend -> regime

var int bullStage = 0
var int bullStageBar = 0
var int bearStage = 0
var int bearStageBar = 0

buyStructOk  = not reqStruct or msBull or structDir >= 0
sellStructOk = not reqStruct or msBear or structDir <= 0

if sweepBull
    bullStage := 1
    bullStageBar := bar_index
if bullStage == 1 and chochUp and buyStructOk
    bullStage := 2
    bullStageBar := bar_index
if bullStage == 2 and dispUpCandle
    bullStage := 3
    bullStageBar := bar_index
if bullStage == 3 and inBullOb
    bullStage := 4
    bullStageBar := bar_index
if bullStage == 4 and inBullFvg
    bullStage := 5
    bullStageBar := bar_index
if bullStage >= 1 and (bar_index - bullStageBar) > pipelineWindow
    bullStage := 0

if sweepBear
    bearStage := 1
    bearStageBar := bar_index
if bearStage == 1 and chochDn and sellStructOk
    bearStage := 2
    bearStageBar := bar_index
if bearStage == 2 and dispDnCandle
    bearStage := 3
    bearStageBar := bar_index
if bearStage == 3 and inBearOb
    bearStage := 4
    bearStageBar := bar_index
if bearStage == 4 and inBearFvg
    bearStage := 5
    bearStageBar := bar_index
if bearStage >= 1 and (bar_index - bearStageBar) > pipelineWindow
    bearStage := 0

bullPipelineReady = bullStage == 5 and volOk and not volDryUp and buyTrendOk and regimeOk
bearPipelineReady = bearStage == 5 and volOk and not volDryUp and sellTrendOk and regimeOk

rawBuy  = bullPipelineReady and trendProbBull >= probFloor
rawSell = bearPipelineReady and trendProbBear >= probFloor

var int lastSignalDir = 0
buySignal  = rawBuy  and lastSignalDir != 1
sellSignal = rawSell and lastSignalDir != -1
if buySignal
    lastSignalDir := 1
    bullStage := 0
if sellSignal
    lastSignalDir := -1
    bearStage := 0
if msBull and lastSignalDir == -1
    lastSignalDir := 0
if msBear and lastSignalDir == 1
    lastSignalDir := 0

f_stageTxt(_s) => _s == 0 ? "idle" : _s == 1 ? "1 Sweep" : _s == 2 ? "2 CHoCH" : _s == 3 ? "3 Displace" : _s == 4 ? "4 OB" : _s == 5 ? "5 FVG" : "—"

// ============================================================================
//  SECTION 16 — RISK MANAGEMENT  (dynamic SL / TP)
// ============================================================================

dynSLBuy  = not na(bullObBot) and bullObBot < close ? bullObBot - atr * 0.15 : close - atr * slAtrMult * profSlMult
dynSLSell = not na(bearObTop) and bearObTop > close ? bearObTop + atr * 0.15 : close + atr * slAtrMult * profSlMult

riskBuy  = close - dynSLBuy
riskSell = dynSLSell - close
rrLiqBuy  = riskBuy  > 0 and not na(liqTargetUp) ? (liqTargetUp - close) / riskBuy   : na
rrLiqSell = riskSell > 0 and not na(liqTargetDn) ? (close - liqTargetDn) / riskSell  : na

dynTPBuy  = not na(rrLiqBuy)  and rrLiqBuy  >= minRR ? liqTargetUp : close + riskBuy  * minRR
dynTPSell = not na(rrLiqSell) and rrLiqSell >= minRR ? liqTargetDn : close - riskSell * minRR

// dynTPBuy/dynTPSell are constructed to already guarantee >= minRR (either the
// qualifying liquidity target or the minRR-multiple fallback), so longRR and
// shortRR are informational for the dashboard, not an extra gate.
longRR  = riskBuy  > 0 ? (dynTPBuy  - close) / riskBuy  : 0.0
shortRR = riskSell > 0 ? (close - dynTPSell) / riskSell : 0.0

// Suggested risk tier from regime + trend strength + volatility + probability
riskScoreRaw = (regime == "Trending" or regime == "Expansion" ? 2 : regime == "Ranging" ? 0 : -1) + (math.abs(trendProbability - 50) / 10) + (atrOk ? 1 : 0) - (atrPct >= 90 ? 2 : 0)
riskLevelTxt = riskScoreRaw >= 3 ? "Low" : riskScoreRaw >= 1 ? "Medium" : "High"
riskLevelCol = riskLevelTxt == "Low" ? colBull : riskLevelTxt == "Medium" ? color.orange : colBear

// ============================================================================
//  SECTION 17 — EXIT ENGINE  (BE, ATR trail, structure trail, liquidity trail)
// ============================================================================

var int   posDir    = 0
var float posEntry  = na
var float posSL      = na
var float posInitRisk = na
var float posTP      = na
var float trailStop   = na
var bool  beDone      = false
var bool  partial1Hit = false
var string entrySession = ""
var string entryGrade   = ""

if buySignal
    posDir := 1
    posEntry := close
    posSL := dynSLBuy
    posInitRisk := riskBuy
    posTP := dynTPBuy
    trailStop := dynSLBuy
    beDone := false
    partial1Hit := false
    entrySession := sessionName
    entryGrade := bullObGrade
if sellSignal
    posDir := -1
    posEntry := close
    posSL := dynSLSell
    posInitRisk := riskSell
    posTP := dynTPSell
    trailStop := dynSLSell
    beDone := false
    partial1Hit := false
    entrySession := sessionName
    entryGrade := bearObGrade

// Break-even
if posDir == 1 and not beDone and not na(posInitRisk) and posInitRisk > 0 and close >= posEntry + posInitRisk * beTriggerR
    trailStop := math.max(trailStop, posEntry)
    beDone := true
if posDir == -1 and not beDone and not na(posInitRisk) and posInitRisk > 0 and close <= posEntry - posInitRisk * beTriggerR
    trailStop := math.min(trailStop, posEntry)
    beDone := true

// Partial TP flag at 1R (informational — this is an indicator, not a broker bridge)
if posDir == 1 and not partial1Hit and not na(posInitRisk) and posInitRisk > 0 and high >= posEntry + posInitRisk
    partial1Hit := true
if posDir == -1 and not partial1Hit and not na(posInitRisk) and posInitRisk > 0 and low <= posEntry - posInitRisk
    partial1Hit := true

// Structure trail: once BE is achieved, trail behind the latest HL/LH.
structTrailBuy  = beDone and not na(lastPL) ? lastPL - atr * 0.1 : na
structTrailSell = beDone and not na(lastPH) ? lastPH + atr * 0.1 : na

if posDir == 1
    atrTrail = close - atr * trailMult
    candidate = na(structTrailBuy) ? atrTrail : math.max(atrTrail, structTrailBuy)
    trailStop := math.max(nz(trailStop, posSL), candidate)
if posDir == -1
    atrTrail = close + atr * trailMult
    candidate = na(structTrailSell) ? atrTrail : math.min(atrTrail, structTrailSell)
    trailStop := math.min(nz(trailStop, posSL), candidate)

haFlipExit  = (posDir == 1 and not haBull) or (posDir == -1 and haBull)
msFlipExit  = (posDir == 1 and msBear) or (posDir == -1 and msBull)
climaxExit  = (posDir == 1 and climaxUp and partial1Hit) or (posDir == -1 and climaxDn and partial1Hit)
trailHit    = (posDir == 1 and low <= trailStop) or (posDir == -1 and high >= trailStop)
tpHit       = (posDir == 1 and high >= nz(posTP, close)) or (posDir == -1 and low <= nz(posTP, close))
slHit       = (posDir == 1 and low <= nz(posSL, close)) or (posDir == -1 and high >= nz(posSL, close))

exitLong  = posDir == 1  and (haFlipExit or msFlipExit or climaxExit or trailHit or tpHit or slHit)
exitShort = posDir == -1 and (haFlipExit or msFlipExit or climaxExit or trailHit or tpHit or slHit)

exitPrice = tpHit ? posTP : slHit ? posSL : trailHit ? trailStop : close

// ============================================================================
//  SECTION 18 — STATISTICS ENGINE
// ============================================================================

var float[]  statR       = array.new<float>()
var string[] statSession = array.new<string>()
var string[] statGrade   = array.new<string>()
maxTrades = 200

if (exitLong or exitShort) and not na(posInitRisk) and posInitRisk > 0
    rMult = posDir == 1 ? (exitPrice - posEntry) / posInitRisk : (posEntry - exitPrice) / posInitRisk
    array.push(statR, rMult)
    array.push(statSession, entrySession)
    array.push(statGrade, entryGrade)
    if array.size(statR) > maxTrades
        array.shift(statR)
        array.shift(statSession)
        array.shift(statGrade)

if exitLong or exitShort
    posDir := 0
    trailStop := na

f_avg(arr) => array.size(arr) > 0 ? array.avg(arr) : 0.0

f_winRate() =>
    n = array.size(statR)
    wins = 0
    if n > 0
        for i = 0 to n - 1
            if array.get(statR, i) > 0
                wins += 1
    n > 0 ? wins / n * 100.0 : 0.0

f_profitFactor() =>
    n = array.size(statR)
    grossW = 0.0
    grossL = 0.0
    if n > 0
        for i = 0 to n - 1
            r = array.get(statR, i)
            if r > 0
                grossW += r
            else
                grossL += -r
    grossL > 0 ? grossW / grossL : grossW > 0 ? 99.0 : 0.0

f_sessionAvg(_name) =>
    n = array.size(statR)
    sum = 0.0
    cnt = 0
    if n > 0
        for i = 0 to n - 1
            if array.get(statSession, i) == _name
                sum += array.get(statR, i)
                cnt += 1
    cnt > 0 ? sum / cnt : float(na)

f_gradeAvg(_g) =>
    n = array.size(statR)
    sum = 0.0
    cnt = 0
    if n > 0
        for i = 0 to n - 1
            if array.get(statGrade, i) == _g
                sum += array.get(statR, i)
                cnt += 1
    cnt > 0 ? sum / cnt : float(na)

totalTrades = array.size(statR)
winRatePct  = f_winRate()
avgRR       = f_avg(statR)
profitFactor = f_profitFactor()
avgLondon = f_sessionAvg("London")
avgNY     = f_sessionAvg("New York")
avgAsia   = f_sessionAvg("Asia")
avgOverlap = f_sessionAvg("LDN/NY Overlap")
avgAPlus = f_gradeAvg("A+")
avgA     = f_gradeAvg("A")
avgB     = f_gradeAvg("B")

f_bestSession() =>
    string best = "—"
    float bv = na
    if not na(avgLondon) and (na(bv) or avgLondon > bv)
        bv := avgLondon
        best := "London"
    if not na(avgNY) and (na(bv) or avgNY > bv)
        bv := avgNY
        best := "New York"
    if not na(avgAsia) and (na(bv) or avgAsia > bv)
        bv := avgAsia
        best := "Asia"
    if not na(avgOverlap) and (na(bv) or avgOverlap > bv)
        bv := avgOverlap
        best := "LDN/NY Overlap"
    best

f_bestGrade() =>
    string best = "—"
    float bv = na
    if not na(avgAPlus) and (na(bv) or avgAPlus > bv)
        bv := avgAPlus
        best := "A+"
    if not na(avgA) and (na(bv) or avgA > bv)
        bv := avgA
        best := "A"
    if not na(avgB) and (na(bv) or avgB > bv)
        bv := avgB
        best := "B"
    best

bestSessionTxt = f_bestSession()
bestPatternTxt = f_bestGrade()

// ============================================================================
//  SECTION 19 — PLOTTING
// ============================================================================

bgCol = showBg ? (mtfBull ? color.new(colBull, 92) : mtfBear ? color.new(colBear, 92) : na) : na
bgcolor(bgCol, title="Trend background")

plotshape(buySignal,  title="BUY",  style=shape.labelup,   location=location.belowbar, color=colBull, textcolor=color.white, text="BUY",  size=size.small)
plotshape(sellSignal, title="SELL", style=shape.labeldown, location=location.abovebar, color=colBear, textcolor=color.white, text="SELL", size=size.small)

if showStruct and bosUp
    label.new(bar_index, low, "BOS", style=label.style_label_up, color=color.new(colBull, 20), textcolor=color.white, size=size.tiny)
if showStruct and bosDn
    label.new(bar_index, high, "BOS", style=label.style_label_down, color=color.new(colBear, 20), textcolor=color.white, size=size.tiny)
if showStruct and chochUp
    label.new(bar_index, low, "CHoCH", style=label.style_label_up, color=color.new(color.teal, 10), textcolor=color.white, size=size.tiny)
if showStruct and chochDn
    label.new(bar_index, high, "CHoCH", style=label.style_label_down, color=color.new(color.maroon, 10), textcolor=color.white, size=size.tiny)
if showSweeps and sweepBull
    label.new(bar_index, low, sweepBullTag != "" ? "Sweep " + sweepBullTag : "Sweep", style=label.style_xcross, color=colBull, textcolor=color.white, size=size.tiny)
if showSweeps and sweepBear
    label.new(bar_index, high, sweepBearTag != "" ? "Sweep " + sweepBearTag : "Sweep", style=label.style_xcross, color=colBear, textcolor=color.white, size=size.tiny)

var line slLine = na
var line tpLine = na
var box  riskBox = na
var box  targetBox = na
if buySignal or sellSignal
    line.delete(slLine)
    line.delete(tpLine)
    box.delete(riskBox)
    box.delete(targetBox)
    eEntry = close
    eSL = buySignal ? dynSLBuy : dynSLSell
    eTP = buySignal ? dynTPBuy : dynTPSell
    slLine := line.new(bar_index, eSL, bar_index + 15, eSL, color=colBear, width=2, style=line.style_dashed)
    tpLine := line.new(bar_index, eTP, bar_index + 15, eTP, color=colBull, width=2, style=line.style_dashed)
    riskBox := box.new(bar_index, eEntry, bar_index + 15, eSL, border_color=na, bgcolor=color.new(colBear, 85))
    targetBox := box.new(bar_index, eEntry, bar_index + 15, eTP, border_color=na, bgcolor=color.new(colBull, 85))

plot(posDir != 0 ? trailStop : na, title="Trailing Stop", color=posDir == 1 ? colBull : colBear, style=plot.style_linebr, linewidth=2)

// Liquidity level lines (drawn on the last bar only, extended right — cheap)
var line[] liqLines = array.new<line>()
var label[] liqLbls = array.new<label>()

f_drawLiq(_price, _txt, _col) =>
    if not na(_price)
        l = line.new(bar_index - 50, _price, bar_index + 50, _price, color=color.new(_col, 40), width=1, style=line.style_dotted)
        lb = label.new(bar_index + 50, _price, _txt, style=label.style_label_left, color=color.new(_col, 40), textcolor=color.white, size=size.tiny)
        array.push(liqLines, l)
        array.push(liqLbls, lb)

if showLiqLines and barstate.islast
    for ln in liqLines
        line.delete(ln)
    for lb in liqLbls
        label.delete(lb)
    array.clear(liqLines)
    array.clear(liqLbls)
    f_drawLiq(pdh, "PDH", colLiq)
    f_drawLiq(pdl, "PDL", colLiq)
    f_drawLiq(pwh, "PWH", colLiq)
    f_drawLiq(pwl, "PWL", colLiq)
    f_drawLiq(asiaHighPrev, "Asia H", color.yellow)
    f_drawLiq(asiaLowPrev, "Asia L", color.yellow)

// ============================================================================
//  SECTION 20 — DASHBOARD
// ============================================================================

f_pos(_s) =>
    switch _s
        "Top Right"    => position.top_right
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left"  => position.bottom_left
        "Middle Right" => position.middle_right
        => position.top_right

var table dash = na
if showDash and na(dash)
    dash := table.new(f_pos(dashPos), 2, 19, border_width=1, frame_color=color.new(color.gray, 50), frame_width=1)

f_row(_t, _r, _label, _val, _col) =>
    table.cell(_t, 0, _r, _label, text_color=color.white, text_size=size.small, bgcolor=color.new(color.gray, 70), text_halign=text.align_left)
    table.cell(_t, 1, _r, _val,   text_color=_col,        text_size=size.small, bgcolor=color.new(color.black, 60), text_halign=text.align_right)

if showDash and barstate.islast
    biasTxt = trendProbability >= 55 ? "BULLISH" : trendProbability <= 45 ? "BEARISH" : "NEUTRAL"
    biasCol = trendProbability >= 55 ? colBull : trendProbability <= 45 ? colBear : color.gray
    gradeTxt = buySignal ? bullObGrade : sellSignal ? bearObGrade : "—"
    expRR = buySignal ? longRR : sellSignal ? shortRR : math.max(longRR, shortRR)
    liqTargetTxt = trendProbability >= 50 ? (na(liqTargetUp) ? "—" : liqTargetUpName + " " + str.tostring(liqTargetUp) + " (strength " + str.tostring(liqTargetUpRank) + "/6)") : (na(liqTargetDn) ? "—" : liqTargetDnName + " " + str.tostring(liqTargetDn) + " (strength " + str.tostring(liqTargetDnRank) + "/6)")
    entryZoneTxt = not na(bullObTop) and trendProbability >= 50 ? "OB " + str.tostring(bullObBot) + "-" + str.tostring(bullObTop) : not na(bearObBot) and trendProbability < 50 ? "OB " + str.tostring(bearObBot) + "-" + str.tostring(bearObTop) : "—"

    table.cell(dash, 0, 0, "SMC ENGINE v2", text_color=color.white, text_size=size.normal, bgcolor=color.new(color.blue, 40))
    table.cell(dash, 1, 0, syminfo.ticker + " " + timeframe.period + " [" + activeProfile + "]", text_color=color.white, text_size=size.small, bgcolor=color.new(color.blue, 40))
    f_row(dash, 1,  "Institutional Bias", biasTxt, biasCol)
    f_row(dash, 2,  "Trend Strength",     trendStrengthTxt, biasCol)
    f_row(dash, 3,  "Probability",        str.tostring(math.round(trendProbability)) + "%", biasCol)
    f_row(dash, 4,  "Market Regime",      regime + (diBullish ? " (DI+)" : " (DI-)"), regimeCol)
    f_row(dash, 5,  "HTF Alignment",      str.tostring(mtfBullCnt) + " bull / " + str.tostring(mtfBearCnt) + " bear (of 6) | struct " + str.tostring(htfStructVotes), mtfBull ? colBull : mtfBear ? colBear : color.gray)
    f_row(dash, 6,  "Structure",          msBull ? "Bullish (" + lastSwingType + ")" : msBear ? "Bearish (" + lastSwingType + ")" : "Neutral", msBull ? colBull : msBear ? colBear : color.gray)
    f_row(dash, 7,  "Buy pipeline",       f_stageTxt(bullStage), bullStage == 5 ? colBull : color.gray)
    f_row(dash, 8,  "Sell pipeline",      f_stageTxt(bearStage), bearStage == 5 ? colBear : color.gray)
    f_row(dash, 9,  "Trade Grade",        gradeTxt, gradeTxt == "A+" or gradeTxt == "A" ? colBull : color.gray)
    f_row(dash, 10, "Expected RR",        "1:" + str.tostring(math.round(expRR, 2)), expRR >= minRR ? colBull : color.gray)
    f_row(dash, 11, "Liquidity Target",   liqTargetTxt, colLiq)
    f_row(dash, 12, "Best Entry Zone",    entryZoneTxt, colOB)
    f_row(dash, 13, "Risk Level",         riskLevelTxt, riskLevelCol)
    f_row(dash, 14, "Volume",             volInstit ? "INSTITUTIONAL (" + str.tostring(instVolScore) + ")" : volOk ? "Above avg" : "Low", volInstit ? color.orange : volOk ? colBull : color.gray)
    f_row(dash, 15, "Session",            sessionName, sessionOk ? colBull : color.gray)
    f_row(dash, 16, "State",              buySignal ? "BUY" : sellSignal ? "SELL" : posDir == 1 ? "Long open" : posDir == -1 ? "Short open" : "Flat", buySignal or posDir == 1 ? colBull : sellSignal or posDir == -1 ? colBear : color.gray)
    f_row(dash, 17, "HTF matrix (M15/H1/H4/D/W/Mo)", showHtfPanel ? f_swc(m15SWC) + "/" + f_swc(h1SWC) + "/" + f_swc(h4SWC) + "/" + f_swc(dSWC) + "/" + f_swc(wSWC) + "/" + f_swc(moSWC) : "hidden", color.silver)
    f_row(dash, 18, "VWAP",               close > vwap ? "Above" : "Below", close > vwap ? colBull : colBear)

var table statTable = na
if showStats and na(statTable)
    statTable := table.new(position.bottom_left, 2, 8, border_width=1, frame_color=color.new(color.gray, 50), frame_width=1)

if showStats and barstate.islast
    table.cell(statTable, 0, 0, "STATISTICS", text_color=color.white, text_size=size.normal, bgcolor=color.new(color.purple, 40))
    table.cell(statTable, 1, 0, str.tostring(totalTrades) + " trades", text_color=color.white, text_size=size.small, bgcolor=color.new(color.purple, 40))
    f_row(statTable, 1, "Win Rate",              str.tostring(math.round(winRatePct, 1)) + "%", winRatePct >= 50 ? colBull : colBear)
    f_row(statTable, 2, "Average RR",            str.tostring(math.round(avgRR, 2)) + "R", avgRR >= 0 ? colBull : colBear)
    f_row(statTable, 3, "Profit Factor",         str.tostring(math.round(profitFactor, 2)), profitFactor >= 1.5 ? colBull : profitFactor >= 1.0 ? color.orange : colBear)
    f_row(statTable, 4, "Best Session",          bestSessionTxt, colBull)
    f_row(statTable, 5, "Most Profitable Grade", bestPatternTxt, colBull)
    f_row(statTable, 6, "Signal Success Rate",   str.tostring(math.round(winRatePct, 1)) + "%", winRatePct >= 50 ? colBull : colBear)
    f_row(statTable, 7, "Sample Size",           str.tostring(totalTrades) + " / " + str.tostring(maxTrades), color.silver)

// ============================================================================
//  SECTION 21 — ALERTS
// ============================================================================

alertcondition(buySignal,  "BUY signal",  "SMC Engine v2: full pipeline BUY")
alertcondition(sellSignal, "SELL signal", "SMC Engine v2: full pipeline SELL")
alertcondition(bosUp or bosDn,     "BOS",   "SMC Engine v2: Break of Structure")
alertcondition(chochUp or chochDn, "CHoCH", "SMC Engine v2: Change of Character")
alertcondition(sweepBull or sweepBear, "Liquidity Sweep", "SMC Engine v2: Liquidity sweep detected")
alertcondition(inBullOb or inBearOb,   "Order Block Touch", "SMC Engine v2: price tapped a graded order block")
alertcondition(inBullFvg or inBearFvg, "FVG Entry", "SMC Engine v2: price entered a fair value gap")
alertcondition(tpHit,  "Take Profit", "SMC Engine v2: take-profit reached")
alertcondition(slHit,  "Stop Loss",   "SMC Engine v2: stop-loss hit")
alertcondition(exitLong or exitShort, "Exit", "SMC Engine v2: exit condition met")

if alOn and buySignal
    alert("SMC v2 BUY " + syminfo.ticker + " @ " + str.tostring(close) + " | prob " + str.tostring(math.round(trendProbability)) + "% | grade " + bullObGrade + " | regime " + regime + " | candle " + f_candlePattern() + " | effort/result " + str.tostring(math.round(effortResult, 2)) + " | SL " + str.tostring(dynSLBuy) + " TP " + str.tostring(dynTPBuy), alert.freq_once_per_bar_close)
if alOn and sellSignal
    alert("SMC v2 SELL " + syminfo.ticker + " @ " + str.tostring(close) + " | prob " + str.tostring(math.round(trendProbBear)) + "% | grade " + bearObGrade + " | regime " + regime + " | candle " + f_candlePattern() + " | effort/result " + str.tostring(math.round(effortResult, 2)) + " | SL " + str.tostring(dynSLSell) + " TP " + str.tostring(dynTPSell), alert.freq_once_per_bar_close)
